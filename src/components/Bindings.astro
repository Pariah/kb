---
// Full bindings, one table set per character. Only the character picked on
// the keyboard shows (the island toggles [data-bindings]); the first is the
// default before it hydrates.
import type { ResolvedCharacter, ResolvedSlot } from "../lib/data";
import { canBind, KEYS, MODIFIER_LABEL, MODIFIERS, type Modifier, PAGED_KEYS } from "../lib/keys";
import { isPaged, slotAt } from "../lib/view";

interface Props {
	characters: ResolvedCharacter[];
}

const { characters } = Astro.props;

interface Cell {
	text: string;
	job?: string;
	open?: boolean;
	blank?: boolean;
}

/** A slot as table text. Stance slots list every stance's ability in order. */
function cell(c: ResolvedCharacter, slot: ResolvedSlot | undefined): Cell {
	if (!slot) return { text: "Open", open: true };
	const text = slot.stances
		? c.stances.map((s) => slot.stances?.[s.id]?.ability ?? "Open").join(" / ")
		: (slot.binding?.ability ?? "Open");
	return { text, job: slot.job?.id };
}

const modCell = (c: ResolvedCharacter, key: string, mod: Modifier): Cell =>
	canBind(key, mod) ? cell(c, slotAt(c, key, mod)) : { text: "", blank: true };

const stanceCell = (c: ResolvedCharacter, key: string, stance: string): Cell => {
	const slot = slotAt(c, key, "bare");
	const b = slot?.stances?.[stance] ?? slot?.binding;
	return b ? { text: b.ability, job: slot?.job?.id } : { text: "Open", open: true };
};

// Every character splits the number row into its own table: one column per
// stance when the bars page, else Bare. Both tables share one fixed grid
// (padded with empty cells) so their columns line up.
const REST = KEYS.filter((k) => !PAGED_KEYS.includes(k) && k !== "`").concat("`");
const PAGED_MODS = MODIFIERS.filter((m) => m !== "bare" && PAGED_KEYS.some((k) => canBind(k, m)));

interface Table {
	heads: string[];
	rows: { key: string; cells: Cell[] }[];
}

function tables(c: ResolvedCharacter): Table[] {
	const paged = PAGED_KEYS.some((k) => isPaged(c, k));
	const top: Table = {
		heads: [...(paged ? c.stances.map((s) => s.label) : [MODIFIER_LABEL.bare]), ...PAGED_MODS.map((m) => MODIFIER_LABEL[m])],
		rows: PAGED_KEYS.map((k) => ({
			key: k,
			cells: [
				...(paged ? c.stances.map((s) => stanceCell(c, k, s.id)) : [modCell(c, k, "bare")]),
				...PAGED_MODS.map((m) => modCell(c, k, m)),
			],
		})),
	};
	const rest: Table = {
		heads: MODIFIERS.map((m) => MODIFIER_LABEL[m]),
		rows: REST.map((k) => ({ key: k, cells: MODIFIERS.map((m) => modCell(c, k, m)) })),
	};
	return [top, rest];
}

const pad = <T,>(xs: T[], n: number, fill: T): T[] => [...xs, ...Array(n - xs.length).fill(fill)];
const BLANK: Cell = { text: "", blank: true };
---

<section id="bindings">
	<h2>bindings</h2>
	{
		characters.map((c, i) => {
			const ts = tables(c);
			const cols = Math.max(...ts.map((t) => t.heads.length));
			return (
				<div class="char" data-bindings={c.slug} hidden={i > 0}>
					{ts.map((t) => (
						<div class="tbl">
							<table style={`--cols: ${cols}`}>
								<colgroup>
									<col class="kc" />
									{Array.from({ length: cols }, () => (
										<col />
									))}
								</colgroup>
								<thead>
									<tr>
										<th>Key</th>
										{pad(t.heads, cols, "").map((h) => (
											<th>{h}</th>
										))}
									</tr>
								</thead>
								<tbody>
									{t.rows.map((r) => (
										<tr>
											<td class="k">{r.key}</td>
											{pad(r.cells, cols, BLANK).map((x) => (
												<td class:list={{ open: x.open }}>
													{!x.blank && <span class="j" style={x.job ? `--c: var(--job-${x.job})` : undefined} />}
													{x.text}
												</td>
											))}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					))}
				</div>
			);
		})
	}
</section>

<style>
	.char {
		display: grid;
		gap: 20px;
		margin-top: 32px;
	}
	.char[hidden] {
		display: none;
	}
	.tbl {
		overflow-x: auto;
	}
	table {
		width: 100%;
		min-width: calc(60px + var(--cols) * 150px);
		table-layout: fixed;
		border-collapse: collapse;
	}
	col.kc {
		width: 60px;
	}
	th,
	td {
		padding: 9px 12px 9px 0;
		border-bottom: 1px solid var(--n-2);
		text-align: left;
		vertical-align: top;
		overflow-wrap: anywhere;
	}
	th {
		font: 400 var(--t-micro) / 1 var(--f-mono);
		font-stretch: 75%;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--n-5);
	}
	td.k {
		font: 500 12px / 1.4 var(--f-mono);
		color: var(--n-8);
	}
	.j {
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 8px;
		background: var(--c, transparent);
	}
	td.open {
		color: var(--n-4);
	}
</style>
