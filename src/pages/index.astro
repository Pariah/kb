---
import Bindings from "../components/Bindings.astro";
import Keyboard from "../components/Keyboard.svelte";
import Macros from "../components/Macros.astro";
import Base from "../layouts/Base.astro";
import { loadData } from "../lib/data";

const { characters, macros } = loadData();
const bodies = Object.fromEntries(macros.map((m) => [m.name, m.body]));
---

<Base title="kb" description="Keybinds and macros for WoW Forever.">
	<main>
		<Keyboard client:load characters={characters} macros={bodies} />
		<Bindings characters={characters} />
		<Macros characters={characters} macros={macros} />
	</main>
</Base>

<script>
	import "../scripts/copy";
</script>

<style>
	main {
		max-width: var(--page-max);
		margin-inline: auto;
		padding-bottom: 96px;
	}
	main :global(section) {
		margin-top: 72px;
	}
	main :global(section > h2) {
		margin: 0 0 6px;
		font: 200 var(--t-h2) / 1.1 var(--f-display);
		font-stretch: 125%;
		color: var(--n-8);
	}
</style>
